# 서버의 /data/tshow/.env 로 둔다 (커밋하지 않는다)
# 공용 Postgres(infra-postgres)에 만든 tshow 전용 데이터베이스·사용자
DB_USERNAME=tshow
DB_PASSWORD=강력한_비밀번호
# 공공데이터 API 인증키 (KOPIS는 kopis.or.kr에서, 나머지는 data.go.kr 일반 인증키)
KOPIS_API_KEY=
TOURAPI_API_KEY=
CULTURE_API_KEY=
# 처음 한 번만 true 로 두면 앱 시작 직후 6개월치를 수집한다 (KOPIS 가 몇 시간 걸린다). 끝나면 지우고 이후에는 매일 새벽 3시(cron)에 증분 수집한다
TSHOW_INGEST_ON_STARTUP=false
# 벡터 색인·AI 추천을 붙일 때 사용
QDRANT_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
